@startuml
title Caso de uso 2 - Autenticar usuário

|Usuário|
start
:Abrir tela de login;
:Preencher e-mail e senha;

 repeat 
  |Usuário|
  :Clicar em "Entrar";

  |CampusHub|
  if(Todos os campos obrigatórios\nestão preenchidos?) then (Sim)

   :Buscar usuário pelo e-mail;
   
   if(Usuário encontrado?) then (Sim)
    
    :Verificar senha usando\no salt e hash armazenados;

    
      if(A senha está correta?) then (Sim)

       :Definir usuário como autenticado;
       :Abrir tela principal;
       stop
       else(Não)
        :Exibir "E-mail ou senha incorretos.";
       endif

    else(Não)
     :Exibir "E-mail ou senha incorretos.";
    endif

   else(Não)
    :Exibir "Preencha todos os campos.";
   endif

  |Usuário|
  :Corrigir os dados e tentar novamente; 

repeat while()

@enduml



